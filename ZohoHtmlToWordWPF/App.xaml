<Application x:Class="ZohoHtmlToWordWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZohoHtmlToWordWPF"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Стиль окна -->
            <Style TargetType="Window">
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="AllowsTransparency" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- ===== КНОПКИ ОКНА (ВСЕ СОСТОЯНИЯ) ===== -->
            <!-- Основной цвет кнопок -->
            <SolidColorBrush x:Key="ButtonColor" Color="#685346"/>
            <SolidColorBrush x:Key="IconColor" Color="White"/>

            <!-- Используем SolidColorBrush напрямую или через DynamicResource -->
            <SolidColorBrush x:Key="MahApps.Brushes.WindowBackground" Color="#685346"/>

            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Background" Color="#685346"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Background.Highlight" Color="#685346"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Background.Pressed" Color="#685346"/>

            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Foreground" Color="White"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Foreground.Highlight" Color="White"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Foreground.Pressed" Color="White"/>

            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Close.Background.Highlight" Color="#685346"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Close.Background.Pressed" Color="#685346"/>

            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Close.Foreground.Highlight" Color="White"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowButton.Close.Foreground.Pressed" Color="White"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>